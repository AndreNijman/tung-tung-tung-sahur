{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tung-relay",
  "main": "worker/relay.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "routes": [
    {
      "pattern": "relay.tung.andrenijman.com",
      "custom_domain": true
    }
  ]
}
